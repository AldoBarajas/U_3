digraph Esquema {
	bgcolor=white compound=true fontcolor="#102740" fontname="DejaVu Sans" fontsize=20 label="ESQUEMA FISICO POSTGRESQL | BIBLIOTECA ESCOLAR" labelloc=t nodesep=0.35 pad=0.26 rankdir=LR ranksep=0.8 splines=spline
